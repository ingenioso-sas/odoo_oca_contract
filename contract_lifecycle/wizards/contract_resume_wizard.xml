<odoo>
    <record id="contract_resume_wizard_form_view" model="ir.ui.view">
        <field name="name">contract.resume.wizard.form</field>
        <field name="model">contract.resume.wizard</field>
        <field name="arch" type="xml">
            <form string="Resume Contract">
                <group>
                    <field name="contract_id" readonly="1" />
                    <field name="pause_id" readonly="1" />
                    <field name="resume_date" />
                </group>
                <footer>
                    <button
                        name="action_resume"
                        string="Resume Contract"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
