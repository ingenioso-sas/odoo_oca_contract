<odoo>
    <record id="contract_pause_reason_form_view" model="ir.ui.view">
        <field name="name">contract.pause.reason.form</field>
        <field name="model">contract.pause.reason</field>
        <field name="arch" type="xml">
            <form string="Pause Reason">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="requires_comment" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_pause_reason_list_view" model="ir.ui.view">
        <field name="name">contract.pause.reason.list</field>
        <field name="model">contract.pause.reason</field>
        <field name="arch" type="xml">
            <list string="Pause Reasons">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="requires_comment" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="action_contract_pause_reason" model="ir.actions.act_window">
        <field name="name">Pause Reasons</field>
        <field name="res_model">contract.pause.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_contract_pause_reason"
        name="Pause Reasons"
        parent="contract.menu_config_contract"
        action="action_contract_pause_reason"
        sequence="22"
    />
</odoo>
