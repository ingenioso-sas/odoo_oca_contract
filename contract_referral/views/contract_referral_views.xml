<odoo>
    <record id="contract_referral_form_view" model="ir.ui.view">
        <field name="name">contract.referral.form</field>
        <field name="model">contract.referral</field>
        <field name="arch" type="xml">
            <form string="Contract Referral">
                <header>
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        invisible="state == 'active'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state == 'cancelled'"
                    />
                    <button
                        name="action_finish"
                        type="object"
                        string="Finish"
                        invisible="state != 'active'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not referred_discount_lost"
                    >
                        The referred customer lost the referral discount permanently due to an overdue invoice.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_show_commissions"
                            type="object"
                            icon="fa-money"
                            class="oe_stat_button"
                            invisible="commission_count == 0"
                        >
                            <field
                                string="Commissions"
                                name="commission_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Referral">
                            <field name="referrer_id" />
                            <field name="referred_id" />
                            <field
                                name="referred_contract_id"
                                domain="[('contract_type', '=', 'sale'), '|', ('partner_id', '=', referred_id), ('commercial_partner_id', '=', referred_id)]"
                            />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="start_date" />
                            <field name="end_date" />
                        </group>
                        <group string="Benefits">
                            <field name="referred_discount_percent" />
                            <field name="referrer_commission_percent" />
                            <field name="commission_base" />
                            <field name="max_months" />
                            <field name="max_invoices" />
                            <field name="paused_days" />
                            <field
                                name="referred_discount_lost"
                                invisible="not referred_discount_lost"
                            />
                            <field
                                name="referred_discount_lost_date"
                                invisible="not referred_discount_lost"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Discount Rules" name="discount_rules">
                            <field name="discount_rule_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="contract_line_id" />
                                    <field name="discount" />
                                    <field name="date_start" />
                                    <field name="date_end" />
                                    <field name="max_invoices" />
                                    <field name="applied_invoice_count" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                        <page string="Commissions" name="commissions">
                            <field name="commission_ids" readonly="1">
                                <list>
                                    <field name="date" />
                                    <field name="invoice_id" />
                                    <field name="base_amount" />
                                    <field name="commission_percent" />
                                    <field name="commission_amount" />
                                    <field name="is_adjustment" optional="hide" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="contract_referral_list_view" model="ir.ui.view">
        <field name="name">contract.referral.list</field>
        <field name="model">contract.referral</field>
        <field name="arch" type="xml">
            <list
                string="Contract Referrals"
                decoration-muted="state in ('cancelled', 'finished')"
                decoration-info="state == 'draft'"
            >
                <field name="name" />
                <field name="referrer_id" />
                <field name="referred_id" />
                <field name="referred_contract_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="referred_discount_percent" />
                <field name="referrer_commission_percent" />
                <field name="commission_count" sum="Commissions" />
                <field name="paused_days" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-muted="state in ('cancelled', 'finished')"
                />
            </list>
        </field>
    </record>

    <record id="contract_referral_search_view" model="ir.ui.view">
        <field name="name">contract.referral.search</field>
        <field name="model">contract.referral</field>
        <field name="arch" type="xml">
            <search>
                <field name="referrer_id" />
                <field name="referred_id" />
                <field name="referred_contract_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    name="lost_discount"
                    string="Discount lost"
                    domain="[('referred_discount_lost', '=', True)]"
                />
                <separator />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <filter
                    name="finished"
                    string="Finished"
                    domain="[('state', '=', 'finished')]"
                />
                <group>
                    <filter
                        name="group_by_referrer"
                        string="Referrer"
                        context="{'group_by': 'referrer_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_contract_referral" model="ir.actions.act_window">
        <field name="name">Referrals</field>
        <field name="res_model">contract.referral</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="contract_referral_search_view" />
    </record>

    <menuitem
        id="menu_contract_referral"
        name="Referrals"
        parent="account.menu_finance_receivables"
        action="action_contract_referral"
        sequence="101"
    />

    <record id="contract_contract_form_view_referral" model="ir.ui.view">
        <field name="name">contract.contract.form.referral</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_show_referrals"
                    type="object"
                    icon="fa-handshake-o"
                    class="oe_stat_button"
                    invisible="contract_type != 'sale' or referral_count == 0"
                >
                    <field
                        string="Referrals"
                        name="referral_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_referral" model="ir.ui.view">
        <field name="name">res.partner.form.referral</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_show_referrals"
                    type="object"
                    icon="fa-handshake-o"
                    class="oe_stat_button"
                    invisible="referral_count == 0"
                >
                    <field
                        string="Referrals"
                        name="referral_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
