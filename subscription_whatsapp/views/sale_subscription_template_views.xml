<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="recurring_sale_subscription_template_views" model="ir.ui.view">
        <field name="name">sale.subscription.template.inherit.whatsapp</field>
        <field name="model">sale.subscription.template</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_mail_template_id']" position="before">
                <field 
                    name="send_notification_mode" 
                    widget="radio" 
                    invisible="invoicing_mode != 'invoice_send'"
                    required="invoicing_mode == 'invoice_send'"/>
            </xpath>
