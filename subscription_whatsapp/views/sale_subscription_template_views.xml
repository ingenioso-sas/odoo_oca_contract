                        <selection>
                            <option value="draft">Draft</option>
                            <option value="invoice">Invoice</option>
                            <option value="sale_and_invoice">Sale order &amp; Invoice</option>
                        </selection>
                    </field>
            </xpath> -->
        </field>
    </record>
</odoo>