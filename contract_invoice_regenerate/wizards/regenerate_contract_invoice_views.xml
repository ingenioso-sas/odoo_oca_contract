<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_regenerate_invoice_form_view" model="ir.ui.view">
        <field name="name">contract.regenerate.invoice.form</field>
        <field name="model">contract.regenerate.invoice</field>
        <field name="arch" type="xml">
            <form>
                <field name="contract_line_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="existing_invoice_ids" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not existing_invoice_ids"
                >
                    Ya existe una factura para este período:
                    <field
                        name="existing_invoice_names"
                        readonly="1"
                        nolabel="1"
                        class="fw-bold"
                    />
                </div>
                <group>
                    <group string="Período">
                        <field name="contract_id" readonly="1" />
                        <field name="period_start" />
                        <field name="period_end" />
                    </group>
                    <group string="Factura">
                        <field name="invoice_date" />
                        <field name="post_invoice" />
                    </group>
                </group>
                <group string="Línea del contrato">
                    <field name="product_id" />
                    <field name="quantity" />
                    <field name="price_unit" />
                </group>
                <div class="text-muted small">
                    La factura se crea para el período indicado y conserva la
                    fecha de factura seleccionada. No se mueve la programación
                    del contrato.
                </div>
                <footer>
                    <button
                        name="action_regenerate_invoice"
                        type="object"
                        string="Regenerar factura"
                        class="btn-primary"
                        invisible="existing_invoice_ids"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
