<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_contract_invoice_regenerate" model="res.groups">
        <field name="name">Contrato: Regenerar facturas</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_contract_invoice_regenerate'))]"
        />
    </record>

    <record id="access_contract_regenerate_invoice" model="ir.model.access">
        <field name="name">contract.regenerate.invoice.access</field>
        <field
            name="model_id"
            ref="model_contract_regenerate_invoice"
        />
        <field
            name="group_id"
            ref="group_contract_invoice_regenerate"
        />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
