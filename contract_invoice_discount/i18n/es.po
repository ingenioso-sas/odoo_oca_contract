#. module: contract_invoice_discount
#: model:ir.model.fields,help:contract_invoice_discount.field_contract_invoice_discount__discount
msgid ""
"Percentage applied to the invoice line. Only the highest applicable "
"discount is used."
msgstr ""
"Porcentaje aplicado a la línea de factura. Solo se usa el descuento "
"aplicable más alto."

#. module: contract_invoice_discount
#: model:ir.model.fields,help:contract_invoice_discount.field_contract_invoice_discount__max_invoices
msgid "Maximum number of invoices with this discount. 0 = unlimited."
msgstr "Máximo de facturas con este descuento. 0 = sin límite."

#. module: contract_invoice_discount
#: model:ir.model.fields,help:contract_invoice_discount.field_contract_invoice_discount__date_end
msgid ""
"Leave empty for no date limit. If set, the discount is prorated when the "
"invoice period overlaps only partially."
msgstr ""
"Dejar vacío para sin límite de fecha. Si se define, el descuento se "
"prorratea cuando el período de la factura se cruza parcialmente."

#. module: contract_invoice_discount
#: model:ir.model.fields,help:contract_invoice_discount.field_contract_template_line__promo_discount
msgid ""
"Default promotional discount copied to new contracts created from this "
"template line."
msgstr ""
"Descuento promocional por defecto que se copia a los contratos nuevos "
"creados desde esta línea de plantilla."

#. module: contract_invoice_discount
#: model:ir.model.fields,help:contract_invoice_discount.field_contract_template_line__promo_duration_months
msgid ""
"Number of months the promotion lasts from the contract line start. 0 = no "
"date limit."
msgstr ""
"Cantidad de meses que dura la promoción desde el inicio de la línea del "
"contrato. 0 = sin límite de fecha."

#. module: contract_invoice_discount
#: model:ir.model.fields,help:contract_invoice_discount.field_contract_template_line__promo_max_invoices
msgid "Maximum number of invoices with the promotion. 0 = unlimited."
msgstr "Máximo de facturas con la promoción. 0 = sin límite."

