<odoo>
    <record id="contract_invoice_discount_form_view" model="ir.ui.view">
        <field name="name">contract.invoice.discount.form</field>
        <field name="model">contract.invoice.discount</field>
        <field name="arch" type="xml">
            <form string="Contract Invoice Discount">
                <header>
                    <button
                        name="action_recompute_date_start"
                        type="object"
                        string="Recalculate start date"
                        icon="fa-refresh"
                        invisible="start_mode == 'fixed_date'"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="contract_line_id" />
                            <field name="contract_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group>
                            <field name="discount" />
                            <field name="start_mode" />
                            <field
                                name="date_start"
                                readonly="start_mode != 'fixed_date'"
                            />
                            <field name="date_end" />
                            <field name="max_invoices" />
                            <field name="applied_invoice_count" />
                            <field name="remaining_invoices" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="source" />
                            <field name="state" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_invoice_discount_list_view" model="ir.ui.view">
        <field name="name">contract.invoice.discount.list</field>
        <field name="model">contract.invoice.discount</field>
        <field name="arch" type="xml">
            <list string="Contract Invoice Discounts">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="discount" />
                <field name="start_mode" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="max_invoices" />
                <field name="applied_invoice_count" />
                <field name="source" />
                <field name="active" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="contract_invoice_discount_search_view" model="ir.ui.view">
        <field name="name">contract.invoice.discount.search</field>
        <field name="model">contract.invoice.discount</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="contract_line_id" />
                <field name="contract_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <separator />
                <filter
                    name="promotion"
                    string="Promotions"
                    domain="[('source', '=', 'promotion')]"
                />
                <filter
                    name="referral"
                    string="Referrals"
                    domain="[('source', '=', 'referral')]"
                />
                <filter
                    name="manual"
                    string="Manual"
                    domain="[('source', '=', 'manual')]"
                />
                <group>
                    <filter
                        name="group_by_contract"
                        string="Contract"
                        context="{'group_by': 'contract_id'}"
                    />
                    <filter
                        name="group_by_source"
                        string="Source"
                        context="{'group_by': 'source'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
