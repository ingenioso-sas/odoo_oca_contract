<odoo>
    <record id="contract_invoice_discount_form_view" model="ir.ui.view">
        <field name="name">contract.invoice.discount.form</field>
        <field name="model">contract.invoice.discount</field>
        <field name="arch" type="xml">
            <form string="Contract Invoice Discount">
                <header>
                    <button
                        name="action_recompute_date_start"
                        type="object"
                        string="Recalculate start date"
                        icon="fa-refresh"
                        invisible="start_mode == 'fixed_date'"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="contract_line_id" />
                            <field name="contract_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group>
                            <field name="discount" />
                            <field name="start_mode" />
                            <field
                                name="date_start"
                                readonly="start_mode != 'fixed_date'"
                                force_save="1"
                            />
                            <field name="date_end" />
                            <field name="max_invoices" />
                            <field name="applied_invoice_count" />
                            <field name="remaining_invoices" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="source" />
                            <field name="pause_policy" />
                            <field name="state" widget="badge" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_invoice_discount_list_view" model="ir.ui.view">
        <field name="name">contract.invoice.discount.list</field>
        <field name="model">contract.invoice.discount</field>
        <field name="arch" type="xml">
            <list
                string="Contract Invoice Discounts"
                decoration-muted="not active or state in ('expired', 'exhausted', 'inactive')"
                decoration-info="state == 'scheduled'"
            >
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="contract_id" optional="show" />
                <field name="contract_line_id" optional="show" />
                <field name="discount" avg="Average Discount" />
                <field name="start_mode" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="max_invoices" />
                <field name="applied_invoice_count" sum="Applied" />
                <field name="source" />
                <field name="pause_policy" optional="hide" />
                <field name="active" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'active'"
                    decoration-info="state == 'scheduled'"
                    decoration-muted="state in ('expired', 'exhausted', 'inactive')"
                />
            </list>
        </field>
    </record>

    <record id="contract_invoice_discount_search_view" model="ir.ui.view">
        <field name="name">contract.invoice.discount.search</field>
        <field name="model">contract.invoice.discount</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="contract_line_id" />
                <field name="contract_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <separator />
                <filter
                    name="promotion"
                    string="Promotions"
                    domain="[('source', '=', 'promotion')]"
                />
                <filter
                    name="referral"
                    string="Referrals"
                    domain="[('source', '=', 'referral')]"
                />
                <filter
                    name="manual"
                    string="Manual"
                    domain="[('source', '=', 'manual')]"
                />
                <group>
                    <filter
                        name="group_by_contract"
                        string="Contract"
                        context="{'group_by': 'contract_id'}"
                    />
                    <filter
                        name="group_by_source"
                        string="Source"
                        context="{'group_by': 'source'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="contract_contract_form_view_invoice_discount" model="ir.ui.view">
        <field name="name">contract.contract.form.invoice.discount</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_show_invoice_discounts"
                    type="object"
                    icon="fa-percent"
                    class="oe_stat_button"
                    invisible="invoice_discount_count == 0"
                >
                    <field
                        string="Discounts"
                        name="invoice_discount_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath
                expr="//field[@name='contract_line_fixed_ids']//list//field[@name='discount']"
                position="after"
            >
                <field name="invoice_discount_count" optional="show" />
            </xpath>
            <xpath
                expr="//field[@name='contract_line_ids']//list//field[@name='discount']"
                position="after"
            >
                <field name="invoice_discount_count" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
