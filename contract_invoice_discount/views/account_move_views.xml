<odoo>
    <record id="view_move_form_invoice_discount" model="ir.ui.view">
        <field name="name">account.move.form.invoice.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field
                    name="contract_discount_name"
                    optional="hide"
                    readonly="1"
                />
                <field
                    name="contract_discount_percent"
                    optional="hide"
                    readonly="1"
                />
                <field
                    name="contract_discount_until"
                    optional="hide"
                    readonly="1"
                />
                <field
                    name="contract_discount_source"
                    optional="hide"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
