#: model:ir.model.fields,field_description:contract_invoice_period.field_account_move_line__contract_period_end
msgid "Contract Period End"
msgstr "Fin del período facturado"

#. module: contract_invoice_period
#: model:ir.model.fields,field_description:contract_invoice_period.field_account_move__contract_period_start
#: model:ir.model.fields,field_description:contract_invoice_period.field_account_move_line__contract_period_start
