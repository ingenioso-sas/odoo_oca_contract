msgstr "Inicio del período facturado"

#. module: contract_invoice_period
#: model_terms:ir.ui.view,arch_db:contract_invoice_period.view_account_invoice_filter_contract_invoice_period
msgid "Contract invoices"
msgstr "Facturas de contrato"

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move__contract_billing_date
#: model:ir.model.fields,help:contract_invoice_period.field_account_move_line__contract_billing_date
msgid "Contract next invoice date used to generate this invoice."
msgstr "Fecha de próxima factura del contrato usada para generar esta factura."

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move__contract_period_end
#: model:ir.model.fields,help:contract_invoice_period.field_account_move_line__contract_period_end
msgid ""
"Last date of the invoiced period. For invoices with lines from different "
"periods it is the latest end date."
msgstr ""
"Última fecha del período facturado. Para facturas con líneas de períodos "
"distintos, es la fecha de fin más tardía."

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move__contract_period_start
#: model:ir.model.fields,help:contract_invoice_period.field_account_move_line__contract_period_start
msgid ""
"First date of the invoiced period. For invoices with lines from different "
"periods it is the earliest start date."
msgstr ""
"Primera fecha del período facturado. Para facturas con líneas de períodos "
"distintos, es la fecha de inicio más temprana."

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move__contract_id
msgid ""
"Contract that originated this invoice. Empty when the invoice was not "
"generated from a contract."
msgstr ""
"Contrato que originó esta factura. Vacío cuando la factura no se generó "
"desde un contrato."

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move_line__contract_period_start
msgid "First date of the period covered by this contract invoice line."
msgstr "Primera fecha del período cubierto por esta línea de factura de contrato."

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move_line__contract_period_end
msgid "Last date of the period covered by this contract invoice line."
msgstr "Última fecha del período cubierto por esta línea de factura de contrato."

#. module: contract_invoice_period
#: model:ir.model.fields,help:contract_invoice_period.field_account_move_line__contract_billing_date
msgid "Date of the next contract invoice used to generate this line."
msgstr "Fecha de la próxima factura del contrato usada para generar esta línea."

#. module: contract_invoice_period
#: model_terms:ir.ui.view,arch_db:contract_invoice_period.view_account_invoice_filter_contract_invoice_period
msgid "Invoiced Period"
msgstr "Período facturado"

