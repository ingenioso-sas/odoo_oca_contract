<odoo>
    <record id="report_invoice_document_contract_invoice_period" model="ir.ui.view">
        <field name="name">
            account.report_invoice_document.contract.invoice.period
        </field>
        <field name="model" eval="False" />
        <field name="inherit_id" ref="account.report_invoice_document" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@id='informations']/div[@name='invoice_date']"
                position="after"
            >
                <div
                    class="col"
                    t-if="o.contract_billing_date"
                    name="contract_billing_date"
                >
                    <strong>Contract Billing Date</strong>
                    <div t-field="o.contract_billing_date">2026-01-01</div>
                </div>
                <div
                    class="col"
                    t-if="o.contract_period_start or o.contract_period_end"
                    name="contract_period"
                >
                    <strong t-if="o.move_type in ('out_refund', 'in_refund')">
                        Credited Period
                    </strong>
                    <strong t-else="">Invoiced Period</strong>
                    <div>
                        <span
                            t-if="o.contract_period_start"
                            t-field="o.contract_period_start"
                        >2026-01-01</span>
                        <span
                            t-if="o.contract_period_start and o.contract_period_end"
                        > - </span>
                        <span
                            t-if="o.contract_period_end"
                            t-field="o.contract_period_end"
                        >2026-01-31</span>
                    </div>
                </div>
            </xpath>
            <xpath
                expr="//td[@name='account_invoice_line_name']"
                position="inside"
            >
                <div
                    t-if="len({(l.contract_period_start, l.contract_period_end) for l in o.invoice_line_ids if l.contract_period_start or l.contract_period_end}) &gt; 1 and (line.contract_period_start or line.contract_period_end)"
                    class="text-muted small"
                    name="line_contract_period"
                >
                    Period:
                    <span
                        t-if="line.contract_period_start"
                        t-field="line.contract_period_start"
                    />
                    <span
                        t-if="line.contract_period_start and line.contract_period_end"
                    > - </span>
                    <span
                        t-if="line.contract_period_end"
                        t-field="line.contract_period_end"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
