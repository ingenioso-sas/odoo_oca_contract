<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_line_form_view_billing_cycle" model="ir.ui.view">
        <field name="name">contract.line form (billing cycle)</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='next_period_dates']"
                position="after"
            >
                <group string="Ciclo de facturación" name="billing_cycle">
                    <group>
                        <field name="billing_anchor_day" />
                    </group>
                    <group>
                        <field name="free_trial_start" />
                        <field name="free_trial_end" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record
