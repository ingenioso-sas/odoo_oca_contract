<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_contract_form_view_billing_cycle" model="ir.ui.view">
        <field name="name">contract.contract form (billing cycle)</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="billing_cycle" string="Ciclo de facturación">
                    <group>
                        <group>
                            <field name="billing_anchor_day" />
                            <field name="skip_zero_invoices" />
                        </group>
                        <group>
                            <field name="free_trial_duration" />
                            <field
                                name="free_trial_unit"
                                invisible="not free_trial_duration"
                            />
                            <field
                                name="free_trial_discount"
                                invisible="not free_trial_duration"
                            />
                        </group>
                    </group>
                    <div class="text-muted">
                        La prueba gratuita se cuenta desde el inicio del servicio y
                        se prorratea entre las facturas que cubran ese rango.
                        Solo aplica a líneas pospago.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
