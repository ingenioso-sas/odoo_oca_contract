<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_contract_notification_channel_tree" model="ir.ui.view">
        <field name="name">contract.notification.channel.tree</field>
        <field name="model">contract.notification.channel</field>
        <field name="arch" type="xml">
            <list string="Contract Notification Channels">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_contract_notification_channel_form" model="ir.ui.view">
        <field name="name">contract.notification.channel.form</field>
        <field name="model">contract.notification.channel</field>
        <field name="arch" type="xml">
            <form string="Contract Notification Channel">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contract_notification_channel" model="ir.actions.act_window">
        <field name="name">Contract Notification Channels</field>
        <field name="res_model">contract.notification.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_contract_notification_channel"
        name="Contract Notification Channels"
        parent="contract.menu_config_contract"
        action="action_contract_notification_channel"
        sequence="30"
    />

</odoo>
