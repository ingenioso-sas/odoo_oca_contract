<odoo>
    <record id="view_move_form_contract_invoice_notify" model="ir.ui.view">
        <field name="name">account.move.form.contract.invoice.notify</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field
                    name="last_overdue_reminder_date"
                    invisible="move_type != 'out_invoice' or not last_overdue_reminder_date"
                />
                <field
                    name="overdue_reminder_count"
                    invisible="move_type != 'out_invoice' or overdue_reminder_count == 0"
                />
            </xpath>
        </field>
    </record>
</odoo>
