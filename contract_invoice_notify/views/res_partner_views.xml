<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_opt_out" model="ir.ui.view">
        <field name="name">res.partner form (contract_invoice_notify opt-out)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Se inserta una fila propia con su etiqueta debajo del bloque
                 de teléfono (el campo phone vive en un <div>, no en un
                 <group>, por lo que un <field> suelto no muestra label). -->
            <xpath expr="(//field[@name='phone'])[1]/.." position="after">
                <div class="o_row">
                    <label for="opt_out_overdue_reminder" />
                    <field name="opt_out_overdue_reminder" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
