<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_contract_form_view" model="ir.ui.view">
        <field name="name">contract.contract.form.inherit.contract.invoice.notify</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <field name="invoice_mail_template_id" position="after">
                <field
                    name="notification_channel_ids"
                    widget="many2many_tags"
                    invisible="invoicing_mode != 'validate_send' and not overdue_reminder_enabled"
                />
            </field>
            <field name="notification_channel_ids" position="after">
                <field
                    name="notification_template_ids"
                    invisible="invoicing_mode != 'validate_send' and not overdue_reminder_enabled"
                >
                    <list editable="bottom">
                        <field name="channel_id" />
                        <field name="purpose" />
                        <field name="template_id" />
                    </list>
                </field>
                <group string="Overdue reminders (digest per contract)">
                    <field name="overdue_reminder_enabled" />
                    <field name="overdue_grace_days" invisible="not overdue_reminder_enabled" />
                    <field name="overdue_resend_after_days" invisible="not overdue_reminder_enabled" />
                    <field name="overdue_max_reminders" invisible="not overdue_reminder_enabled" />
                </group>
            </field>
        </field>
    </record>
</odoo>
