<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_contract_form_view_notify" model="ir.ui.view">
        <field name="name">contract.contract form view (in contract_invoice_notify)</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <field name="invoice_mail_template_id" position="after">
                <field name="send_notification_mode" invisible="invoicing_mode != 'validate_send'" />
            </field>
            <!-- renew_alert_days was discarded in the 19.0 migration; the
                 overdue digest group is anchored after send_notification_mode. -->
            <field name="send_notification_mode" position="after">
                <field
                    name="whatsapp_template_id"
                    invisible="invoicing_mode != 'validate_send' or send_notification_mode not in ('whatsapp', 'both')"
                />
                <group string="Overdue reminders (digest per contract)">
                    <field name="overdue_reminder_enabled" />
                    <field name="overdue_grace_days" invisible="not overdue_reminder_enabled" />
                    <field name="overdue_resend_after_days" invisible="not overdue_reminder_enabled" />
                    <field name="overdue_max_reminders" invisible="not overdue_reminder_enabled" />
                </group>
            </field>
        </field>
    </record>
</odoo>
