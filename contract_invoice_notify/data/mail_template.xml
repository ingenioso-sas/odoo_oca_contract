<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="email_template_contract_invoice_notify" model="mail.template">
        <field name="name">Contract invoice: payment link + overdue info</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="subject">{{ object.company_id.name }} Invoice {{ object.name }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.partner_id.name" />,</p>
                <p>Your invoice <strong t-out="object.name" /> for
                <strong t-out="format_amount(object.amount_total, object.currency_id)" /> is now available.</p>
                <p>
                    <a t-att-href="object._get_payment_portal_url()"
                       target="_blank"
                       style="background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;">View and pay invoice</a>
                </p>
                <t t-set="overdue" t-value="object._get_contract_overdue_invoices()" />
                <t t-if="overdue">
                    <p>You also have <strong t-out="len(overdue)" /> overdue
                    invoice(s): <t t-out="', '.join(overdue.mapped('name'))" />
                    totalling <strong t-out="format_amount(sum(overdue.mapped('amount_residual')), object.currency_id)" />.
                    You can pay all of them from your portal.</p>
                </t>
                <t t-set="statement_url" t-value="object._get_notification_statement_url()" />
                <t t-if="statement_url">
                    <p>View and pay all your pending invoices here:</p>
                    <p>
                        <a t-att-href="statement_url"
                           target="_blank"
                           style="background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;">View all my invoices</a>
                    </p>
                </t>
                <p>Thank you for your business.</p>
            </div>
        </field>
    </record>
    <record id="email_template_contract_overdue_digest" model="mail.template">
        <field name="name">Contract overdue digest: pay-all link</field>
        <field name="model_id" ref="contract.model_contract_contract" />
        <field name="subject">Contract {{ object.name }}: pending overdue invoices</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.partner_id.name" />,</p>
                <p>Contract <strong t-out="object.name" />: you have pending overdue
                invoices:</p>
                <t t-set="invoices" t-value="object._get_overdue_reminder_candidates()" />
                <ul>
                    <t t-foreach="invoices" t-as="inv">
                        <li><t t-out="inv.name" /> — due <t t-out="inv.invoice_date_due" /> — balance <t t-out="format_amount(inv.amount_residual, inv.currency_id)" /></li>
                    </t>
                </ul>
                <t t-set="statement_url" t-value="object._get_notification_statement_url()" />
                <t t-if="statement_url">
                    <p>View and pay all your pending invoices here:</p>
                    <p>
                        <a t-att-href="statement_url"
                           target="_blank"
                           style="background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;">View all my invoices</a>
                    </p>
                </t>
                <p t-else="">
                    <a t-att-href="object._get_overdue_pay_all_url(invoices)"
                       target="_blank"
                       style="background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;">Pay invoices</a>
                </p>
                <p>If you have already paid, please disregard this message.</p>
            </div>
        </field>
    </record>
    <record id="whatsapp_template_contract_invoice" model="mail.template">
        <field name="name">Contract invoice: WhatsApp notification</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="subject">Invoice {{ object.name }} available for payment</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.partner_id.display_name" />,</p>
                <p>Your invoice <strong t-out="object.name" /> for
                <strong t-out="format_amount(object.amount_total, object.currency_id)" /> is now available.</p>
                <p>You can view and pay it here:
                    <a t-att-href="object._get_payment_portal_url()">View and pay invoice</a>
                </p>
                <t t-set="overdue" t-value="object._get_contract_overdue_invoices()" />
                <t t-if="overdue">
                    <p>You also have <strong t-out="len(overdue)" /> overdue
                    invoice(s) (<t t-out="', '.join(overdue.mapped('name'))" />)
                    totalling <strong t-out="format_amount(sum(overdue.mapped('amount_residual')), object.currency_id)" />.
                    You can pay all of them from your portal.</p>
                </t>
                <t t-set="statement_url" t-value="object._get_notification_statement_url()" />
                <t t-if="statement_url">
                    <p>View and pay all your pending invoices here: <a t-att-href="statement_url">View all my invoices</a></p>
                </t>
                <p>Thank you for your business.</p>
            </div>
        </field>
    </record>
</odoo>
