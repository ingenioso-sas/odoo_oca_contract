#. module: contract_invoice_notify
#: model:mail.template,body_html:contract_invoice_notify.whatsapp_template_contract_invoice
msgid ""
"<div>\n"
"                <p>Hola <t t-out=\"object.partner_id.display_name\"/>,</p>\n"
"                <p>Tu factura <strong t-out=\"object.name\"/> por\n"
"                <strong t-out=\"object.amount_total\"/>\n"
"                <strong t-out=\"object.currency_id.name\"/> ya está disponible.</p>\n"
"                <p>Puedes verla y pagarla aquí:\n"
"                    <a t-att-href=\"object._get_payment_portal_url()\">Ver y pagar factura</a>\n"
"                </p>\n"
"                <t t-set=\"overdue\" t-value=\"object._get_contract_overdue_invoices()\"/>\n"
"                <t t-if=\"overdue\">\n"
"                    <p>Además tienes <strong t-out=\"len(overdue)\"/> factura(s)\n"
"                    pendiente(s) (<t t-out=\"', '.join(overdue.mapped('name'))\"/>)\n"
"                    por <strong t-out=\"sum(overdue.mapped('amount_residual'))\"/>\n"
"                    <t t-out=\"object.currency_id.name\"/>.\n"
"                    Puedes pagarlas todas desde tu portal.</p>\n"
"                </t>\n"
"                <t t-set=\"statement_url\" t-value=\"object._get_notification_statement_url()\"/>\n"
"                <t t-if=\"statement_url\">\n"
"                    <p>Consulta y paga todas tus facturas pendientes aquí: <a t-att-href=\"statement_url\">Ver todas mis facturas</a></p>\n"
"                </t>\n"
"                <p>Gracias por tu confianza.</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: contract_invoice_notify
#: model:mail.template,body_html:contract_invoice_notify.email_template_contract_overdue_digest
msgid ""
"<div>\n"
"                <p>Hola <t t-out=\"object.partner_id.name\"/>,</p>\n"
"                <p>Contrato <strong t-out=\"object.name\"/>: tienes facturas vencidas\n"
"                pendientes. No se fusionan montos, este es solo un resumen:</p>\n"
"                <t t-set=\"invoices\" t-value=\"object._get_overdue_reminder_candidates()\"/>\n"
"                <ul>\n"
"                    <t t-foreach=\"invoices\" t-as=\"inv\">\n"
"                        <li><t t-out=\"inv.name\"/> — vence <t t-out=\"inv.invoice_date_due\"/> — saldo <t t-out=\"inv.amount_residual\"/></li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p>\n"
"                    <a t-att-href=\"object._get_overdue_pay_all_url(invoices)\" target=\"_blank\" style=\"background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;\">Pagar todo</a>\n"
"                </p>\n"
"                <t t-set=\"statement_url\" t-value=\"object._get_notification_statement_url()\"/>\n"
"                <t t-if=\"statement_url\">\n"
"                    <p>Consulta y paga todas tus facturas pendientes aquí:</p>\n"
"                    <p>\n"
"                        <a t-att-href=\"statement_url\" target=\"_blank\" style=\"background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;\">Ver todas mis facturas</a>\n"
"                    </p>\n"
"                </t>\n"
"                <p>Si ya pagaste, ignora este mensaje.</p>\n"
"            </div>\n"
"        "
msgstr ""

